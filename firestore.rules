rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Doctors are public read-only content, edited only via the seed script / console.
    match /doctors/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // Leads are written only by the server (Admin SDK bypasses these rules entirely),
    // so no client, authenticated or not, can read or write them directly.
    match /leads/{leadId} {
      allow read, write: if false;
    }
  }
}
